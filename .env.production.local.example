# Copy to .env.production.local for local AWS verification. Do not commit secrets.

USE_AWS_DATA_LAYER=true
APP_AWS_REGION=ap-southeast-2
APP_TABLE_NAME=visbuild-shopify-app
PUBLISH_LAMBDA_ARN=arn:aws:lambda:YOUR_REGION:YOUR_AWS_ACCOUNT_ID:function:visbuild-shopify-data-publish
SCHEDULER_ROLE_ARN=arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/visbuild-shopify-data-SchedulerInvokeRole-REPLACE_ME
SCHEDULE_LAMBDA_ARN=arn:aws:lambda:YOUR_REGION:YOUR_AWS_ACCOUNT_ID:function:visbuild-shopify-data-schedule
SHOPIFY_TOKEN_SECRET_PREFIX=visbuild-shopify/token

SHOPIFY_API_KEY=your-partners-client-id
SHOPIFY_API_SECRET=your-partners-client-secret
SCOPES=read_content,write_content,read_files
SHOPIFY_APP_URL=https://your-app.amplifyapp.com

SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx

# ASSETS_BUCKET_NAME=visbuild-media-your-account-id
